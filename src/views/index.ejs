<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= __('index.title') %></title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800 font-sans">

  <!-- Header -->
  <header class="bg-blue-600 text-white">
    <div class="container mx-auto p-4 flex justify-between items-center">
      <a href="#" class="text-xl font-bold">ALBA ROMERO</a>
      <input type="checkbox" id="menu" class="hidden peer">
      <label for="menu" class="md:hidden cursor-pointer">
        <img src="/img/menu.jpg" class="w-8 h-8" alt="<%= __('index.menu') %>">
      </label>
      <nav class="hidden peer-checked:block md:block">
        <ul class="flex flex-col md:flex-row gap-4 mt-4 md:mt-0">
          <li><a href="#" class="hover:underline"><%= __('index.nav.services') %></a></li>
          <li><a href="/login?form=login" class="hover:underline"><%= __('index.nav.login') %></a></li>
          <li><a href="/admin/contacts" class="hover:underline"><%= __('index.nav.contactList') %></a></li>
          <li><a href="/getPayment" class="hover:underline"><%= __('index.nav.paymentList') %></a></li>
          <!-- Language Dropdown -->
          <li class="relative group">
            <button class="flex items-center gap-1 hover:text-blue-400 transition duration-200">
              🌐 <span>Idioma</span>
              <i class="fas fa-chevron-down text-xs mt-[2px]"></i>
            </button>
            <ul class="absolute right-0 mt-2 bg-white text-black rounded-md shadow-lg overflow-hidden opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-200 transform origin-top min-w-[120px] z-50">
              <li>
                <a href="/?lang=es" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
                  🇪🇸 Español
                </a>
              </li>
              <li>
                <a href="/?lang=en" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
                  🇺🇸 English
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </div>

    <div class="text-center px-6 py-12 max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-4"><%= __('index.hero.title') %></h1>
      <p class="text-lg"><%= __('index.hero.subtitle') %></p>
    </div>
  </header>

  <!-- ¿Qué son Kayaks y Bicicletas? -->
  <section class="py-12 bg-gray-100">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-semibold mb-4"><%= __('index.about.title') %></h2>
      <p class="mb-8"><%= __('index.about.description') %></p>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-4 shadow rounded">
          <img src="/img/kayaks1.jpg" alt="" class="w-full h-64 object-cover mb-4">
          <h3 class="text-xl font-bold mb-2"><%= __('index.about.kayak.title') %></h3>
          <p class="mb-4"><%= __('index.about.kayak.description') %></p>
          <a href="#" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"><%= __('index.about.seeMore') %></a>
        </div>
        <div class="bg-white p-4 shadow rounded">
          <img src="/img/bicicleta.jpg" alt="" class="w-full h-64 object-cover mb-4">
          <h3 class="text-xl font-bold mb-2"><%= __('index.about.bicycle.title') %></h3>
          <p class="mb-4"><%= __('index.about.bicycle.description') %></p>
          <a href="#" class="inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"><%= __('index.about.seeMore') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios de Alquiler -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-semibold mb-8"><%= __('index.rental.title') %></h2>
      <div class="grid md:grid-cols-2 gap-8 mb-6">
        <div class="bg-gray-50 p-6 shadow rounded">
          <img src="/img/alquiler-k1.jpg" alt="" class="w-full h-48 object-cover mb-4">
          <h3 class="text-xl font-bold mb-2"><%= __('index.rental.subscription.title') %></h3>
          <p class="mb-4"><%= __('index.rental.subscription.description') %></p>
        </div>
        <div class="bg-gray-50 p-6 shadow rounded">
          <img src="/img/alquiler-b1.jpg" alt="" class="w-full h-48 object-cover mb-4">
          <h3 class="text-xl font-bold mb-2"><%= __('index.rental.daily.title') %></h3>
          <p class="mb-4"><%= __('index.rental.daily.description') %></p>
        </div>
      </div>
      <a href="#" class="inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700"><%= __('index.rental.rentButton') %></a>
    </div>
  </section>

  <!-- NUEVA SECCIÓN DE SERVICIOS -->
  <section class="py-12 bg-gray-100">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl font-semibold mb-8"><%= __('index.featured.title') %></h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 shadow rounded">
          <h3 class="text-xl font-bold mb-2"><%= __('index.featured.kayakTour.title') %></h3>
          <p class="mb-4"><%= __('index.featured.kayakTour.description') %></p>
          <a href="/payment" class="inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700"><%= __('index.featured.acquire') %></a>
        </div>
        <div class="bg-white p-6 shadow rounded">
          <h3 class="text-xl font-bold mb-2"><%= __('index.featured.bicycleRoute.title') %></h3>
          <p class="mb-4"><%= __('index.featured.bicycleRoute.description') %></p>
          <a href="/payment" class="inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700"><%= __('index.featured.acquire') %></a>
        </div>
        <div class="bg-white p-6 shadow rounded">
          <h3 class="text-xl font-bold mb-2"><%= __('index.featured.familyPlan.title') %></h3>
          <p class="mb-4"><%= __('index.featured.familyPlan.description') %></p>
          <a href="/payment" class="inline-block bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700"><%= __('index.featured.acquire') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-blue-900 text-white py-6">
    <div class="container mx-auto px-6 text-center">
      <h3 class="text-lg font-bold mb-2"><%= __('index.footer.socialMedia') %></h3>
      <ul class="space-y-1">
        <li><a href="#" class="hover:underline">Instagram</a></li>
        <li><a href="#" class="hover:underline">Facebook</a></li>
        <li><a href="#" class="hover:underline">+58 000 0000000</a></li>
        <li><a href="#" class="hover:underline">sport&go1234qgmail.com</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>