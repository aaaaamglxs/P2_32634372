<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Contactos</title>
    <link rel="stylesheet" href="/css/table.css">
    <link rel="stylesheet" href="/css/estilos.css">   
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="bg-blue-600 text-white">
        <div class="container mx-auto p-4 flex justify-between items-center">
          <a href="#" class="text-xl font-bold">ALBA ROMERO</a>
          <input type="checkbox" id="menu" class="hidden peer">
          <label for="menu" class="md:hidden cursor-pointer">
            <img src="/img/menu.jpg" class="w-8 h-8" alt="<%= __('index.menu') %>">
        </label>
        <nav class="hidden peer-checked:block md:block">
            <ul class="flex flex-col md:flex-row gap-4 mt-4 md:mt-0">
              <li><a href="#" class="hover:underline"><%= __('index.nav.services') %></a></li>
              <li><a href="/login?form=login" class="hover:underline"><%= __('index.nav.login') %></a></li>
              <li><a href="/admin/contacts" class="hover:underline"><%= __('index.nav.contactList') %></a></li>
              <li><a href="/getPayment" class="hover:underline"><%= __('index.nav.paymentList') %></a></li>
              <!-- Language Dropdown -->
              <li class="relative group">
                <button class="flex items-center gap-1 hover:text-blue-400 transition duration-200">
                  🌐 <span>Idioma</span>
                  <i class="fas fa-chevron-down text-xs mt-[2px]"></i>
              </button>
              <ul class="absolute right-0 mt-2 bg-white text-black rounded-md shadow-lg overflow-hidden opacity-0 group-hover:opacity-100 scale-95 group-hover:scale-100 transition-all duration-200 transform origin-top min-w-[120px] z-50">
                  <li>
                    <a href="/admin/contacts?lang=es" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
                      🇪🇸 Español
                  </a>
              </li>
              <li>
                <a href="/admin/contacts?lang=en" class="block px-4 py-2 hover:bg-blue-100 transition-colors">
                  🇺🇸 English
              </a>
          </li>
      </ul>
  </li>
</ul>
</nav>
</div>

<div class="text-center px-6 py-12 max-w-4xl mx-auto">
  <h1 class="text-4xl font-bold mb-4"><%= __('index.hero.title') %></h1>
  <p class="text-lg"><%= __('index.hero.subtitle') %></p>
</div>
</header>
<div class="flex justify-center mt-40 items-center contacts-header flex-col">
    <h1 class="contacts-title"><%= __('contacto.title') %></h1>
</div>
<form id="filterForm" class="mt-10 w-full max-w-lg mx-auto">
    <div class="relative">
        <input
        type="text"
        id="searchInput"
        placeholder="<%= __('contacto.search_placeholder') %>"
        class="w-full px-4 py-3 pr-10 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 placeholder-gray-400 text-gray-700"
        />
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
        </div>
    </div>
</form>

<div id="contactsContainer">

    <% if (contacts.length > 0) { %>
    <table class="contacts-table">
        <thead>
            <tr>
                <th><%= __('contacto.table_headers.name') %></th>
                <th><%= __('contacto.table_headers.country') %></th>
                <th><%= __('contacto.table_headers.email') %></th>
                <th><%= __('contacto.table_headers.comment') %></th>
                <th><%= __('contacto.table_headers.ip') %></th>
                <th><%= __('contacto.table_headers.date') %></th>
            </tr>
        </thead>
        <tbody>
            <% contacts.forEach(contact => { %>
            <tr>
                <td data-label="<%= __('contacto.table_headers.name') %>"><%= contact.nombre %></td>
                <td data-label="<%= __('contacto.table_headers.country') %>"><%= contact.pais %></td>
                <td data-label="<%= __('contacto.table_headers.email') %>" class="contact-email"><%= contact.email %></td>
                <td data-label="<%= __('contacto.table_headers.comment') %>"><%= contact.comentario %></td>
                <td data-label="<%= __('contacto.table_headers.ip') %>" class="contact-ip"><%= contact.ip %></td>
                <td data-label="<%= __('contacto.table_headers.date') %>" class="contact-date">
                    <%= new Date(contact.createdAt).toLocaleDateString(locale) %>
                    <br>
                    <%= new Date(contact.createdAt).toLocaleTimeString(locale) %>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>
    <% } else { %>
    <p class="flex justify-center items-center mt-10"><%= __('contacto.no_records') %></p>
    <% } %>
    
</div>
<script src="/js/filter.js"></script>
</body>
</html>