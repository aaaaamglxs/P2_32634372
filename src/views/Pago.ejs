<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SPORT&GO</title>
    <link rel="stylesheet" href="css/Pago.css">
</head>
<body>

    <div class="container">
        <h3>Pagos</h3>
        <form id="formularioPayment" >
            <div class="input-box">
                <span>Correo Electrónico</span>
                <input id="correo" type="email" maxlength="16" class="CE-input">
            </div>

            <div class="input-box">
                <span>Nombre del Titular</span>
                <input type="text" maxlength="16" id="nombreTitular" class="NOM-input">
            </div>

            <div class="input-box">
                <span>Número de la Tarjeta</span>
                <input type="text" id="cardNumber" maxlength="16" class="NT-input">
            </div>

                <div class="flexbox">
                    <div class="input-box row">
                        <span style="width: 100%;" >Fecha de Expiración</span>
                            <input class="inp" type="number" min="1" max="12" id="expMonth" placeholder="5" value="5">
                            <input class="inp" type="number" min="2025" max="2040"  id="expYear" placeholder="2025" value="2025">  
                    </div>
                </div>

                <div class="input-box">
                    <span>CVV/CVC</span>
                    <input type="text" id="cvv" maxlength="4" pattern="[0-9]{3,4}" class="cvv-input">
                </div>

                <div class="input-box">
                    <h4>Moneda:</h4>
                    <select id="currency" name="currency" required>
                        <option value="USD">USD $</option>
                        <option value="EUR">EUR €</option>
                        <option value="GBP">GBP £</option>
                        <option value="JPY">JPY ¥</option>
                    </select>
                </div>
          <div class="input-box" >
              <h4>Monto:</h4>
              <input type="number" id="amount" name="amount" placeholder="0.00" min="0" step="0.01" required>
              <button class="submit-btn" >Pagar</button>
            </div>
            </form>
    </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src='/js/fetch2.js'></script>
</body>
</html>